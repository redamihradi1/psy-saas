SECRET_KEY=change-me-generate-a-real-random-value
DEBUG=False

# Notifications push (rappels de consultation). Générer une paire de clés avec :
#   python scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=contact@example.com

# Jeton pour déclencher l'envoi des rappels via un cron externe (ex: cron-job.org)
# si le plan d'hébergement ne permet pas de tâche planifiée toutes les 10-15 min.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET_TOKEN=

# Assistant IA des bilans (offre gratuite Groq : https://console.groq.com > API Keys,
# activer "Zero Data Retention" dans Data Controls). Vide = bilans sans IA.
IA_API_KEY=
# Optionnels (valeurs par défaut) :
# IA_API_URL=https://api.groq.com/openai/v1/chat/completions
# IA_MODELE=openai/gpt-oss-120b
# IA_QUOTA_JOUR_PAR_CABINET=40
